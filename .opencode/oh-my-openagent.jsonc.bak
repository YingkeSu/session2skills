{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",

  // Agent configurations
  // Primary providers: OpenAI (GPT) and ZhipuAI (GLM)
  // Supplementary provider: GitHub Copilot (copilot.* models)
  //
  // Model strategy:
  // - GPT series: openai/gpt-5.4, gpt-5.4-mini, gpt-5.4-nano, gpt-5.3-codex, gpt-5.2
  // - GLM series: zhipuai-coding-plan/glm-5, glm-4.7, glm-4.7-flash (latest as of 2026)
  // - Copilot series: copilot.gpt-4.1, copilot.gpt-4o, copilot.claude-3.7-sonnet, copilot.o1, copilot.o3-mini, etc.
  //
  // Fallback priority: Primary GLM/GPT → Copilot supplementary models

  "agents": {
    // Sisyphus: Main orchestrator
    // GLM-5 as primary (latest GLM, Claude-like behavior)
    // Fallback: GPT-5.4, then Copilot reasoning models
    "sisyphus": {
      "model": "zhipuai-coding-plan/glm-5",
      "variant": "max",
      "fallback_models": [
        "zhipuai-coding-plan/glm-4.7",
	"openai/gpt-5.4",
        "copilot.o1",
        "copilot.gpt-4.1"
      ]
    },

    // Oracle: Architecture/debugging consultation - Read-only consultant
    // GPT-5.4 excels at deep reasoning and architectural thinking
    // Fallback includes Copilot's o1 and o3-mini reasoning models
    "oracle": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.3-codex",
        {
          "model": "openai/gpt-5.4",
          "variant": "medium"
        },
        "zhipuai-coding-plan/glm-5",
        "copilot.o1",
        "copilot.o3-mini",
        "copilot.gpt-4.1"
      ]
    },

    // Explore: Fast codebase grep/search
    // GLM-4.7 speed-first, GPT-nano and Copilot mini as fallbacks
    "explore": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "variant": "low",
      "fallback_models": [
        "zhipuai-coding-plan/glm-4.7-flash",
        "openai/gpt-5.4-nano",
        "copilot.gpt-4o-mini"
      ]
    },

    // Librarian: Documentation and code search
    // GLM-4.7-flash for fast doc search
    // Copilot Gemini 2.0 Flash offers 1M context window for large docs
    "librarian": {
      "model": "zhipuai-coding-plan/glm-4.7-flash",
      "fallback_models": [
        "openai/gpt-5.4-nano",
        "copilot.gemini-2.0-flash",
        "copilot.gpt-4o-mini"
      ]
    },

    // Prometheus: Strategic planner
    // GLM-5 for comprehensive planning, GPT and Copilot as fallbacks
    "prometheus": {
      "model": "zhipuai-coding-plan/glm-5",
      "fallback_models": [
        "openai/gpt-5.4",
        "openai/gpt-5.4-mini",
        "copilot.gpt-4.1",
        "copilot.claude-3.7-sonnet"
      ]
    },

    // Hephaestus: Deep autonomous worker - The Legitimate Craftsman
    // MUST be GPT-5.4 - built specifically for GPT's reasoning style
    // Fallback to Codex and Copilot reasoning models
    "hephaestus": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.3-codex",
        "zhipuai-coding-plan/glm-5",
        "copilot.o1",
        "copilot.o3-mini"
      ]
    },

    // Multimodal-Looker: Vision/screenshots
    // GPT-5.4-mini supports vision
    // Copilot Claude Sonnet 4 also supports vision/attachments
    "multimodal-looker": {
      "model": "openai/gpt-5.4-mini",
      "variant": "medium",
      "fallback_models": [
        "zhipuai-coding-plan/glm-4.7",
        "copilot.claude-sonnet-4",
        "copilot.gpt-4o"
      ]
    },

    // Metis: Plan consultant
    // GLM-5 for consultation, GPT and Copilot as fallbacks
    "metis": {
      "model": "zhipuai-coding-plan/glm-5",
      "fallback_models": [
        "openai/gpt-5.4-mini",
        "copilot.gpt-4.1",
        "copilot.claude-3.7-sonnet"
      ]
    },

    // Momus: Plan reviewer - Ruthless reviewer
    // GPT-5.4 with xhigh for high-accuracy verification
    // Copilot reasoning models as supplementary options
    "momus": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "fallback_models": [
        "openai/gpt-5.3-codex",
        {
          "model": "openai/gpt-5.4",
          "variant": "high"
        },
        "zhipuai-coding-plan/glm-5",
        "copilot.o1",
        "copilot.o3-mini"
      ]
    },

    // Atlas: Todo orchestrator - lightweight coordination
    // GLM-4.7 fast enough for todo management
    "atlas": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "variant": "medium",
      "fallback_models": [
        "openai/gpt-5.4-nano",
        "zhipuai-coding-plan/glm-4.7-flash",
        "copilot.gpt-4o-mini"
      ]
    }
  },

  // Category configurations for task delegation
  "categories": {
    // Quick: Trivial tasks - single file changes, typos
    // GLM-4.7 for speed, GPT-nano and Copilot mini as fallbacks
    "quick": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "variant": "low",
      "description": "Trivial tasks - single file changes, typo fixes",
      "fallback_models": [
        "openai/gpt-5.4-nano",
        "copilot.gpt-4o-mini"
      ]
    },

    // Deep: Autonomous research + execution
    // GPT-5.4 as primary, Copilot reasoning models as fallback
    "deep": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "description": "Autonomous problem-solving, thorough research",
      "fallback_models": [
        "zhipuai-coding-plan/glm-5",
        "copilot.o1",
        "copilot.gpt-4.1"
      ]
    },

    // Ultrabrain: Hard logic, architecture decisions
    // GPT-5.4 xhigh for deep reasoning
    // Copilot o1 and o3-mini as supplementary reasoning engines
    "ultrabrain": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "description": "Hard logic, architecture decisions, algorithms",
      "fallback_models": [
        "openai/gpt-5.3-codex",
        {
          "model": "openai/gpt-5.4",
          "variant": "high"
        },
        "zhipuai-coding-plan/glm-5",
        "copilot.o1",
        "copilot.o3-mini",
        "copilot.gpt-4.1"
      ]
    },

    // Visual-engineering: Frontend, UI/UX, design
    // GLM-5 primary, Copilot models with attachment support as fallback
    "visual-engineering": {
      "model": "zhipuai-coding-plan/glm-5",
      "description": "Frontend, UI/UX, design, styling, animation",
      "fallback_models": [
        "openai/gpt-5.4-mini",
        "copilot.gpt-4o",
        "copilot.claude-sonnet-4"
      ]
    },

    // Unspecified-low: General tasks, low effort
    // GLM-4.7 for speed on low-effort tasks
    "unspecified-low": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "variant": "low",
      "description": "General tasks, low effort",
      "fallback_models": [
        "openai/gpt-5.4-nano",
        "copilot.gpt-4o-mini"
      ]
    },

    // Unspecified-high: General tasks, high effort
    // GPT-5.4 primary, Copilot reasoning models as fallback
    "unspecified-high": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "description": "General tasks, high effort",
      "fallback_models": [
        "zhipuai-coding-plan/glm-5",
        "copilot.gpt-4.1",
        "copilot.o3-mini"
      ]
    },

    // Writing: Documentation, prose
    // GLM-5 for quality writing tasks
    "writing": {
      "model": "zhipuai-coding-plan/glm-5",
      "variant": "low",
      "description": "Documentation, prose, technical writing",
      "fallback_models": [
        "zhipuai-coding-plan/glm-4.7",
        "copilot.gpt-4o",
        "copilot.claude-3.7-sonnet"
      ]
    },

    // Artistry: Creative approaches
    // GLM-5 primary, Copilot Claude models for creative diversity
    "artistry": {
      "model": "zhipuai-coding-plan/glm-5",
      "description": "Creative/unconventional approaches",
      "fallback_models": [
        "openai/gpt-5.4-mini",
        "openai/gpt-5.4-nano",
        "copilot.claude-3.7-sonnet",
        "copilot.claude-sonnet-4"
      ]
    }
  },

  // Background task concurrency limits
  // Copilot provider added with reasonable concurrency limits
  "background_task": {
    "providerConcurrency": {
      "openai": 5,
      "zhipuai-coding-plan": 10,
      "copilot": 3
    },
    "modelConcurrency": {
      // OpenAI models
      "openai/gpt-5.4": 3,
      "openai/gpt-5.3-codex": 2,
      "openai/gpt-5.4-mini": 5,
      "openai/gpt-5.4-nano": 5,
      "openai/gpt-5.2": 5,
      // GLM models
      "zhipuai-coding-plan/glm-5": 5,
      "zhipuai-coding-plan/glm-4.7": 10,
      "zhipuai-coding-plan/glm-4.7-flash": 10,
      // Copilot models (lower limits due to subscription constraints)
      "copilot.gpt-4.1": 3,
      "copilot.gpt-4o": 3,
      "copilot.gpt-4o-mini": 5,
      "copilot.claude-3.7-sonnet": 3,
      "copilot.claude-sonnet-4": 3,
      "copilot.o1": 2,
      "copilot.o3-mini": 3,
      "copilot.o4-mini": 3,
      "copilot.gemini-2.0-flash": 5,
      "copilot.gemini-2.5-pro": 3
    }
  },

  // Enable runtime fallback for resilience
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [400, 429, 503, 529],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60,
    "notify_on_fallback": true
  },

  // Experimental features
  "experimental": {
    "aggressive_truncation": true,
    "task_system": true
  },

  // Sisyphus agent configuration
  "sisyphus_agent": {
    "planner_enabled": true,
    "replace_plan": true
  },

  // LSP configuration for Python project
  "lsp": {
    "pylsp": {
      "command": ["pylsp"],
      "extensions": [".py"],
      "priority": 10
    }
  }
}
