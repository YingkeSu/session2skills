{
  "name": "session2skills",
  "version": "0.1.0",
  "description": "Analyze OpenCode sessions and generate personalized workflow skills.",
  "type": "module",
  "bin": {
    "session2skills": "./dist/cli/main.js"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "opencode",
    "ai",
    "skill",
    "session-analysis",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YingkeSu/session2skills"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "build:all": "npm run build && npm run build:web",
    "verify:web": "npm run build:all && node scripts/ensure-playwright-browser.mjs && npm run test:e2e:web",
    "postbuild": "node scripts/fix-bin-mode.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "typecheck:electron": "tsc --noEmit -p electron/tsconfig.json",
    "dev": "tsx src/cli/main.ts",
    "start": "node dist/cli/main.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "vitest run tests/e2e/",
    "test:e2e:web": "vitest run tests/e2e/serve.test.ts tests/e2e/web-flow.test.ts",
    "electron:build:main": "tsc -p electron/tsconfig.json && node scripts/create-electron-cjs-marker.mjs",
    "electron:dev": "npm run build:all && npm run electron:build:main && electron dist-electron/main.js",
    "electron:build": "npm run build:all && npm run electron:build:main && electron-builder",
    "electron:build:mac": "npm run build:all && npm run electron:build:main && electron-builder --mac",
    "electron:build:win": "npm run build:all && npm run electron:build:main && electron-builder --win",
    "electron:build:linux": "npm run build:all && npm run electron:build:main && electron-builder --linux",
    "electron:smoke": "node scripts/electron-smoke-test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@opencode-ai/sdk": "1.4.0",
    "@tanstack/react-query": "^5.101.0",
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.0",
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@electron/rebuild": "^4.0.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.3.5",
    "vitest": "^3.2.4"
  }
}
